{
 "cleanUrls": true,
 "trailingSlash": false,
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=31536000; includeSubDomains"
    },
    {
     "key": "Cross-Origin-Opener-Policy",
     "value": "same-origin-allow-popups"
    },
    {
     "key": "Cross-Origin-Resource-Policy",
     "value": "same-origin"
    },
    {
     "key": "X-Permitted-Cross-Domain-Policies",
     "value": "none"
    },
    {
     "key": "Content-Security-Policy",
     "value": "default-src 'self'; img-src 'self' data: https://i.ytimg.com https://lh3.googleusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' https://accounts.google.com; connect-src 'self' https://brasilapi.com.br https://n8n.srv1800205.hstgr.cloud https://accounts.google.com; frame-src https://accounts.google.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
    }
   ]
  },
  {
   "source": "/assets/fonts/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/assets/(css|js)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600, must-revalidate"
    }
   ]
  },
  {
   "source": "/assets/(img|art|icons)/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=604800, must-revalidate"
    }
   ]
  }
 ],
 "rewrites": [
  {
   "source": "/programas/:slug",
   "destination": "/pg-programas/:slug"
  },
  {
   "source": "/conteudos/:slug",
   "destination": "/pg-conteudos/:slug"
  },
  {
   "source": "/solucoes/:slug",
   "destination": "/pg-solucoes/:slug"
  },
  {
   "source": "/home-equity/:slug",
   "destination": "/pg-home-equity/:slug"
  },
  {
   "source": "/credito-com-garantia-de-imovel/:slug",
   "destination": "/pg-credito-com-garantia-de-imovel/:slug"
  },
  {
   "source": "/situacoes/:slug",
   "destination": "/pg-situacoes/:slug"
  },
  {
   "source": "/credito-para-empresas/:slug",
   "destination": "/pg-credito-para-empresas/:slug"
  },
  {
   "source": "/patrimonio-imobiliario/:slug",
   "destination": "/pg-patrimonio-imobiliario/:slug"
  },
  {
   "source": "/imoveis/:slug",
   "destination": "/pg-imoveis/:slug"
  },
  {
   "source": "/credito-alto-valor/:slug",
   "destination": "/pg-credito-alto-valor/:slug"
  },
  {
   "source": "/finalidades/:slug",
   "destination": "/pg-finalidades/:slug"
  },
  {
   "source": "/cidades/:slug",
   "destination": "/pg-cidades/:slug"
  },
  {
   "source": "/comparativos/:slug",
   "destination": "/pg-comparativos/:slug"
  }
 ]
}