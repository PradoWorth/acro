# Espelho do .htaccess (a hospedagem oficial é a Hostinger/Apache; este arquivo só
# vale para Netlify/Cloudflare Pages). CSS e JS são referenciados com ?v=<hash do
# conteúdo>, então podem ficar em cache por um ano. HTML sempre revalida.
# Atenção: a CSP própria do simulador (/simulador-home-equity) existe só no
# .htaccess; numa hospedagem que use este arquivo, ela precisa ser replicada.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*.json
  Cache-Control: public, max-age=86400
/assets/img/*
  Cache-Control: public, max-age=604800, must-revalidate
/assets/art/*
  Cache-Control: public, max-age=604800, must-revalidate
/assets/icons/*
  Cache-Control: public, max-age=604800, must-revalidate
